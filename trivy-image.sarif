            {
              "id": "CVE-2026-76957",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "libexpat: libexpat: Memory corruption vulnerability allows arbitrary code execution or denial of service"
              },
              "fullDescription": {
                "text": "libexpat before 2.8.4 lacks handler call depth tracking with custom encoding callbacks. Thus, a use-after-free can occur. NOTE: this is similar to CVE-2026-50219, CVE-2026-56131 and CVE-2026-56412."
              },
