# Once Human Server Configuration
# Copy to .env and edit

# Starry Studio Private Hive license token (required)
# Obtain from https://www.oncehuman.game/2026/csfy/
HIVE_LICENSE=

# Game server settings
SERVER_NAME=My Once Human Server
MAX_PLAYERS=16
PVE_ENABLED=True
DAY_LENGTH=60
NIGHT_LENGTH=30
XP_MULTIPLIER=1.0
RESOURCE_MULTIPLIER=1.0
DROP_MULTIPLIER=1.0
